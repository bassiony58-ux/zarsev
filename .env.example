# ZARSEV Local Development Environment Configuration
# Copy this file to .env and fill in your local values.
# Real .env files are in .gitignore and must never be committed.

PORT=3000
NODE_ENV=development
JWT_SECRET=

# Local PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE_DEV=zarsev_dev
PGDATABASE_TEST=zarsev_test

# Local Storage
STORAGE_LOCAL_DIR=./storage
